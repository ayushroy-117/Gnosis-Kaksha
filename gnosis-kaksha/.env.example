# ==============================================================================
# Gnosis Kaksha — Environment Configuration Template
# ==============================================================================
# Copy this file to .env when deploying:
#   cp .env.example .env
# Fill in your production credentials before running docker compose.
# ==============================================================================

# ─── Supabase (self-hosted on the VPS — see deploy/README.md) ────────────────
# Server-only. The browser never talks to Supabase directly.
# In docker on the VPS: http://api-gw:8000   Local dev: http://127.0.0.1:54321
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=your-anon-key
# Service role key bypasses RLS — keep secret, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site & Domain Settings ───────────────────────────────────────────────────
# Use your VPS public domain or IP (e.g. https://gnosiskaksha.in or http://123.45.67.89:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# ─── UPI (manual payment verification) ────────────────────────────────────────
# The payee VPA encoded in every payment QR code. Double-check this is right.
NEXT_PUBLIC_UPI_ID=gnosiskaksha@upi

# ─── WhatsApp Integration (Pending Fee Reminders) ─────────────────────────────
# Meta WhatsApp Cloud API (Graph API)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=

# (Optional) Twilio WhatsApp fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ─── Remove.bg Tool (Background Remover) ──────────────────────────────────────
# https://www.remove.bg/api
REMOVE_BG_API_KEY=

# ─── Resend (Email Notifications) ─────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
