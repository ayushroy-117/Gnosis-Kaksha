# ==============================================================================
# Gnosis Kaksha — Environment Configuration Template
# ==============================================================================
# Copy this file to .env when deploying:
#   cp .env.example .env
# Fill in your production credentials before running docker compose.
# ==============================================================================

# ─── Supabase (Database & Authentication) ─────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Secret Service Role Key (Keep secret — never expose to client browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Site & Domain Settings ───────────────────────────────────────────────────
# Use your VPS public domain or IP (e.g. https://gnosiskaksha.in or http://123.45.67.89:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# ─── Razorpay (Online Admissions & Fees) ──────────────────────────────────────
# Razorpay Dashboard → Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ─── WhatsApp Integration (Pending Fee Reminders) ─────────────────────────────
# Meta WhatsApp Cloud API (Graph API)
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=

# (Optional) Twilio WhatsApp fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ─── Remove.bg Tool (Background Remover) ──────────────────────────────────────
# https://www.remove.bg/api
REMOVE_BG_API_KEY=

# ─── Resend (Email Notifications) ─────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
